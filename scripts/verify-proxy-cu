#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
  echo "verify-proxy-cu: expected exactly one CU-0, CU-1, or --self-test argument" >&2
  exit 2
fi
case "$1" in
  CU-0|CU-1|--self-test) ;;
  *) echo "verify-proxy-cu: expected exactly one CU-0, CU-1, or --self-test argument" >&2; exit 2 ;;
esac

repo_root=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")/.." && /bin/pwd -P)
cd "$repo_root"
approved_home=$(/usr/bin/id -P "$(/usr/bin/id -un)" | /usr/bin/awk -F: '{print $9}')
case "$approved_home" in
  /*) ;;
  *) echo "verify-proxy-cu: approved home is unavailable" >&2; exit 1 ;;
esac
[ -d "$approved_home" ] || { echo "verify-proxy-cu: approved home is unavailable" >&2; exit 1; }
exec /usr/bin/env -i \
  HOME="$approved_home" \
  GOCACHE="$approved_home/Library/Caches/go-build" \
  GOMODCACHE="$approved_home/go/pkg/mod" \
  GOPATH="$approved_home/go" \
  GOENV=off GOFLAGS= GONOSUMDB='*' GOPROXY=off GOSUMDB=off \
  GOTELEMETRY=off GOTOOLCHAIN=local GOWORK=off \
  LC_ALL=C PATH=/usr/bin:/bin TZ=UTC \
  /opt/homebrew/bin/go run ./internal/tools/proxycu "$1"
